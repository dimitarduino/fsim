PORT=3000

# YouTube Data API (OAuth 2.0 web client)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=unlisted
YOUTUBE_SCHEDULE_MINUTES=60

# TikTok Content Posting API (redirect MUST be https:// — use ngrok for local)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR-SUBDOMAIN.ngrok-free.app/oauth/tiktok/callback
TIKTOK_REFRESH_TOKEN=
TIKTOK_POST_MODE=direct
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/oauth/x/callback
X_REFRESH_TOKEN=
X_SCOPES=tweet.read tweet.write users.read offline.access media.write

# Optional: AI-generated titles & descriptions
GEMINI_API_KEY=
# Prefer a model your key can call (list via Generative Language API). Avoid gluing the key onto this value.
GEMINI_MODEL=gemini-flash-latest

# Optional: denser fixture “why” notes (fixtures themselves come from ESPN)
# GEMINI_API_KEY above is reused when set

SAVE_LOCAL_COPY=true
REQUIRE_YOUTUBE=false
MUSIC_VOLUME=0.55
SFX_VOLUME=0.85
